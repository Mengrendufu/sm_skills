      "target_state_id": "target-state",
      "effect": "preserved",
      "mappings": [
        {
          "runtime": "ts_hsm",
          "location": "SampleState.handle"
        },
        {
          "runtime": "sm_hsm",
          "location": "Sample_state_"
        },
        {
          "runtime": "rs_hsm_",
          "location": "Sample_state_"
        }
      ],
      "notes": []
    }
  ],
  "choice_checks": [
