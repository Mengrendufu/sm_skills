          "behavior": "target-state-id",
          "mappings": [
            {
              "runtime": "ts_hsm",
              "location": "SampleState.handle"
            },
            {
              "runtime": "sm_hsm",
              "location": "Sample_state_"
            },
            {
              "runtime": "rs_hsm_",
              "location": "Sample_state_"
            }
          ]
        },
        {
          "guard": "else",
          "kind": "internal",
          "behavior": "handled",
          "mappings": [
            {
              "runtime": "ts_hsm",
              "location": "SampleState.handle"
            },
            {
              "runtime": "sm_hsm",
              "location": "Sample_state_"
            },
            {
              "runtime": "rs_hsm_",
              "location": "Sample_state_"
            }
          ]
        }
      ],
      "notes": []
    }
