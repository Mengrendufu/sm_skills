{
  "version": "1.0",
  "machine_name": "SampleMachine",
  "inputs": {
    "ir_path": "assets/examples/<case>/<machine>.ir.json",
    "trace_path": "assets/examples/<case>/<machine>.trace.txt",
    "is_reliable": true,
    "diagnostics": []
