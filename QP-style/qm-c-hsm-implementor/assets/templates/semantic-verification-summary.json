        "state_id": "child-state-id",
        "parent_id": "parent-state-id"
      }
    ],
    "notes": []
  },
  "init_check": {
    "status": "PASS",
    "top_initial": {
      "source": "TOP",
      "target_state_id": "root-state-id"
    },
    "composite_initials": [
      {
        "state_id": "composite-state-id",
        "target_state_id": "leaf-state-id"
      }
    ],
    "trace_alignment": true,
    "notes": []
  },
  "transition_checks": [
    {
      "transition_id": "state::EVENT#0",
      "status": "PASS",
      "source_state_id": "state",
